HOST=0.0.0.0
PORT=3000
APP_NAME=Jellygate
APP_VERSION=0.1.0
UI_BASE_PATH=/__jellygate

JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_PUBLIC_URL=https://media.example.com
JELLYFIN_BRIDGE_PATH=/JellygateBridge/start

AURRAL_URL=http://aurral:3001

COOKIE_NAME=jellygate_session
COOKIE_SECRET=replace-with-a-long-random-cookie-secret
COOKIE_SECURE=true
HANDOFF_SECRET=replace-with-the-same-shared-secret-configured-in-the-plugin
SESSION_TTL_SECONDS=43200

ALLOW_PASSWORD_LOGIN=true
ALLOW_JELLYFIN_HANDOFF=true

SIGNUP_URL=
PASSWORD_RESET_URL=
